# Copy to .env and adjust. Every setting in src/neuralstate/config.py can be set as NS_<NAME>.

NS_DATABASE_URL=postgresql+asyncpg://neuralstate:neuralstate@127.0.0.1:5432/neuralstate

# Require X-API-Key on the REST API and a login on the dashboard.
# NS_API_KEY=change-me

# Reasoning model for extraction, contradiction checks and rule synthesis:
#   anthropic (default, needs ANTHROPIC_API_KEY) | openai (OPENAI_API_KEY) | ollama | fake (offline heuristics)
NS_LLM_PROVIDER=anthropic
# NS_LLM_MODEL=claude-opus-5-5
# NS_LLM_EFFORT=medium
# NS_OLLAMA_URL=http://localhost:11434

# Embeddings: fastembed (default, local, 384-dim) | openai | ollama | fake
# NS_EMBED_DIM is fixed when you run `neuralstate migrate`; it must match the model
# (fastembed bge-small: 384, ollama nomic-embed-text: 768, openai: any, via `dimensions`).
NS_EMBED_PROVIDER=fastembed
NS_EMBED_DIM=384

# Learning behavior
# NS_MIN_RULE_EVIDENCE=5
# NS_CONTRADICTION_MARGIN=0.20
# NS_CYCLE_EPISODE_THRESHOLD=20
# NS_CYCLE_INTERVAL_SECONDS=900
